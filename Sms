   "source": [
    "# SMS Spam Collection Data Cleaning\n",
    "This notebook downloads, explores, cleans, and exports the UCI SMS Spam Collection dataset."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Import Libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import urllib.request\n",
    "import zipfile"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1 & 2: Download and Extract Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Download dataset\n",
    "url = \"https://archive.ics.uci.edu/static/public/228/sms+spam+collection.zip\"\n",
    "urllib.request.urlretrieve(url, \"sms.zip\")\n",
    "\n",
    "# Step 2: Extract dataset\n",
    "with zipfile.ZipFile(\"sms.zip\", \"r\") as z:\n",
    "    z.extract(\"SMSSpamCollection\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 3 & 4: Load and Explore Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Load dataset\n",
    "df = pd.read_csv(\n",
    "    \"SMSSpamCollection\",\n",
    "    sep=\"\\t\",\n",
    "    header=None,\n",
    "    names=[\"label\", \"message\"]\n",
    ")\n",
    "\n",
    "# Step 4: Explore dataset\n",
    "print(\"First 5 Rows:\")\n",
    "print(df.head())\n",
    "\n",
    "print(\"Dataset Shape:\")\n",
    "print(df.shape)\n",
    "\n",
    "print(\"Columns:\")\n",
    "print(df.columns)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 5, 6 & 7: Handle Missing Values and Duplicates"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 5: Check missing values\n",
    "print(\"Missing Values:\")\n",
    "print(df.isnull().sum())\n",
    "\n",
    "# Step 6: Remove missing values\n",
    "df = df.dropna()\n",
    "\n",
    "# Step 7: Remove duplicates\n",
    "print(\"Duplicates:\", df.duplicated().sum())\n",
    "df = df.drop_duplicates()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 8, 9 & 10: Check Class Distribution and Save Cleaned Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 8: Count Ham and Spam\n",
    "print(\"Ham and Spam Count:\")\n",
    "print(df[\"label\"].value_counts())\n",
    "\n",
    "# Step 9: Select required columns\n",
    "cleaned_df = df[[\"label\", \"message\"]]\n",
    "\n",
    "# Step 10: Save cleaned dataset\n",
    "cleaned_df.to_csv(\"cleaned_sms.csv\", index=False)\n",
    "\n",
    "print(\"Cleaning Completed Successfully!\")\n",
    "print(\"Final Shape:\", cleaned_df.shape)"
   ]
  }
